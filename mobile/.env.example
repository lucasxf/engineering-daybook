# Copy to .env.local and fill in values
# All EXPO_PUBLIC_* vars are bundled into the app — do NOT store secrets here

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth — web/Expo Go client ID (required for development with Expo Go)
# Obtain from Google Cloud Console → OAuth 2.0 client IDs → Web application type
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google OAuth — Android native client ID (optional; only needed for native Android OAuth, not Expo Go)
# Obtain from Google Cloud Console → OAuth 2.0 client IDs → Android type
# Requires the app's SHA-1 fingerprint to be registered in the Cloud Console
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Google OAuth — iOS native client ID (optional; only needed for native iOS OAuth, not Expo Go)
# Obtain from Google Cloud Console → OAuth 2.0 client IDs → iOS type
# Requires the app's bundle ID to be registered in the Cloud Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
