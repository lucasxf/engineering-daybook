# Android release signing credentials
# Copy this file to .env.signing and fill in the real values.
# .env.signing is gitignored — never commit it.
#
# To retrieve credentials:
#   eas credentials --platform android
#   → select "Keystore" → "Download existing keystore"
#   The CLI prints alias + passwords during the download flow.
#
# ANDROID_KEYSTORE_PATH is relative to android/app/ (Gradle working dir)
ANDROID_KEYSTORE_PATH=release.keystore
ANDROID_KEYSTORE_PASSWORD=<keystore-password>
ANDROID_KEY_ALIAS=<key-alias>
ANDROID_KEY_PASSWORD=<key-password>
