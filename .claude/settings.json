{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/scripts/run-track-usage.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/scripts/run-track-usage.sh\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",

      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git show *)",
      "Bash(git show-ref *)",
      "Bash(git ls-tree *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git update-index *)",
      "Bash(git -C *)",

      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh run *)",

      "Bash(export *)",

      "Bash(./mvnw *)",
      "Bash(mvn *)",

      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx expo *)",

      "Bash(docker compose *)"
    ]
  }
}
